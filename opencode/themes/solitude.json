{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "darkBase": "#101315",
    "darkSurface": "#171b1d",
    "darkOverlay": "#282d30",
    "darkSelected": "#33393d",
    "darkBorder": "#46545b",
    "darkText": "#d3d6d7",
    "darkTextDim": "#b9bec0",
    "darkMuted": "#8b9397",
    "darkDim": "#707a80",
    "darkRed": "#d9847c",
    "darkRedBright": "#e39a92",
    "darkOrange": "#d49a70",
    "darkYellow": "#d1b879",
    "darkGreen": "#9fbd8a",
    "darkCyan": "#82b8b3",
    "darkBlue": "#86a9c7",
    "darkBlueBright": "#9bbbd5",
    "darkPurple": "#b39ac8",
    "darkRose": "#c996aa",
    "lightBase": "#faf4ed",
    "lightSurface": "#fffaf3",
    "lightOverlay": "#f2e9e1",
    "lightSelected": "#dfdad9",
    "lightBorder": "#cecacd",
    "lightText": "#575279",
    "lightSubtle": "#797593",
    "lightMuted": "#9893a5",
    "lightLove": "#b4637a",
    "lightGold": "#ea9d34",
    "lightRose": "#d7827e",
    "lightPine": "#286983",
    "lightFoam": "#56949f",
    "lightIris": "#907aa9"
  },
  "theme": {
    "primary": { "dark": "darkBlue", "light": "lightPine" },
    "secondary": { "dark": "darkPurple", "light": "lightIris" },
    "accent": { "dark": "darkCyan", "light": "lightFoam" },
    "error": { "dark": "darkRed", "light": "lightLove" },
    "warning": { "dark": "darkYellow", "light": "lightGold" },
    "success": { "dark": "darkGreen", "light": "lightFoam" },
    "info": { "dark": "darkBlue", "light": "lightPine" },
    "text": { "dark": "darkText", "light": "lightText" },
    "textMuted": { "dark": "darkMuted", "light": "lightSubtle" },
    "background": { "dark": "darkBase", "light": "lightBase" },
    "backgroundPanel": { "dark": "darkSurface", "light": "lightSurface" },
    "backgroundElement": { "dark": "darkOverlay", "light": "lightOverlay" },
    "border": { "dark": "darkBorder", "light": "lightBorder" },
    "borderActive": { "dark": "darkBlueBright", "light": "lightFoam" },
    "borderSubtle": { "dark": "darkOverlay", "light": "lightSelected" },
    "diffAdded": { "dark": "darkGreen", "light": "lightFoam" },
    "diffRemoved": { "dark": "darkRed", "light": "lightLove" },
    "diffContext": { "dark": "darkMuted", "light": "lightMuted" },
    "diffHunkHeader": { "dark": "darkBlue", "light": "lightPine" },
    "diffHighlightAdded": { "dark": "darkGreen", "light": "lightFoam" },
    "diffHighlightRemoved": { "dark": "darkRedBright", "light": "lightLove" },
    "diffAddedBg": { "dark": "darkSurface", "light": "lightSurface" },
    "diffRemovedBg": { "dark": "darkSurface", "light": "lightSurface" },
    "diffContextBg": { "dark": "darkBase", "light": "lightBase" },
    "diffLineNumber": { "dark": "darkDim", "light": "lightMuted" },
    "diffAddedLineNumberBg": { "dark": "darkOverlay", "light": "lightOverlay" },
    "diffRemovedLineNumberBg": { "dark": "darkOverlay", "light": "lightOverlay" },
    "markdownText": { "dark": "darkText", "light": "lightText" },
    "markdownHeading": { "dark": "darkBlue", "light": "lightPine" },
    "markdownLink": { "dark": "darkCyan", "light": "lightFoam" },
    "markdownLinkText": { "dark": "darkBlueBright", "light": "lightPine" },
    "markdownCode": { "dark": "darkGreen", "light": "lightRose" },
    "markdownBlockQuote": { "dark": "darkTextDim", "light": "lightSubtle" },
    "markdownEmph": { "dark": "darkYellow", "light": "lightGold" },
    "markdownStrong": { "dark": "darkBlueBright", "light": "lightPine" },
    "markdownHorizontalRule": { "dark": "darkBorder", "light": "lightBorder" },
    "markdownListItem": { "dark": "darkPurple", "light": "lightIris" },
    "markdownListEnumeration": { "dark": "darkCyan", "light": "lightFoam" },
    "markdownImage": { "dark": "darkPurple", "light": "lightIris" },
    "markdownImageText": { "dark": "darkRose", "light": "lightRose" },
    "markdownCodeBlock": { "dark": "darkText", "light": "lightText" },
    "syntaxComment": { "dark": "darkDim", "light": "lightMuted" },
    "syntaxKeyword": { "dark": "darkPurple", "light": "lightIris" },
    "syntaxFunction": { "dark": "darkBlue", "light": "lightPine" },
    "syntaxVariable": { "dark": "darkText", "light": "lightText" },
    "syntaxString": { "dark": "darkGreen", "light": "lightRose" },
    "syntaxNumber": { "dark": "darkOrange", "light": "lightGold" },
    "syntaxType": { "dark": "darkCyan", "light": "lightFoam" },
    "syntaxOperator": { "dark": "darkYellow", "light": "lightLove" },
    "syntaxPunctuation": { "dark": "darkTextDim", "light": "lightSubtle" }
  }
}
