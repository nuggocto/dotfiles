// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "cli_default_open_behavior": "existing_window",
  "project_panel": {
    "dock": "left",
  },
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "git_panel": {
    "dock": "left",
  },
  "agent_buffer_font_size": 20.0,
  "agent_ui_font_size": 22.0,
  "agent_servers": {
    "claude-acp": {
      "type": "registry",
    },
    "codex-acp": {
      "type": "registry",
    },
    "opencode": {
      "type": "registry",
    },
  },
  "edit_predictions": {
    "provider": "zed",
  },
  "vim_mode": true,
  "agent": {
    "inline_assistant_model": {
      "provider": "zed.dev",
      "model": "gpt-5.4",
      "enable_thinking": false,
    },
    "dock": "right",
    "tool_permissions": {
      "default": "confirm",
    },
    "message_editor_min_lines": 4,
    "default_profile": "ask",
    "play_sound_when_agent_done": "always",
    "model_parameters": [],
  },
  "ui_font_weight": 600.0,
  "buffer_font_weight": 700.0,
  "terminal": {
    "minimum_contrast": 65.0,
    "cursor_shape": "block",
    "font_size": 22.0,
  },
  "ui_font_family": "VictorMono Nerd Font Mono",
  "buffer_font_family": "VictorMono Nerd Font Mono",
  "icon_theme": {
    "mode": "system",
    "light": "Catppuccin Latte",
    "dark": "Catppuccin Mocha",
  },
  "base_keymap": "VSCode",
  "ui_font_size": 22.0,
  "buffer_font_size": 22.0,

  "theme": {
    "mode": "system",
    "light": "Rosé Pine Dawn",
    "dark": "Gruvbox Dark Soft",
  },
  "experimental.theme_overrides": {
    "syntax": {
      "comment": {
        "font_style": "italic",
      },
      "keyword": {
        "font_style": "italic",
      },
    },
  },
}
