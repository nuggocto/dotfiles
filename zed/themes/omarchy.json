{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Solitude",
  "author": "HANCORE-linux, customized for readability",
  "themes": [
    {
      "name": "Omarchy Dark",
      "appearance": "dark",
      "style": {
        "background": "#101315D9",
        "background.appearance": "blurred",
        "editor.background": "#101315D9",
        "editor.foreground": "#d3d6d7",
        "text": "#d3d6d7",
        "text.accent": "#86a9c7",
        "text.muted": "#8b9397",
        "text.disabled": "#626a6e",
        "text.placeholder": "#707a80",
        "icon": "#b9bec0",
        "icon.accent": "#86a9c7",
        "icon.muted": "#707a80",
        "ignored": "#707a80",
        "hidden": "#626a6e",
        "predictive": "#707a80",
        "border": "#33393d",
        "border.focused": "#86a9c7",
        "border.selected": "#86a9c7",
        "border.variant": "#282d30",
        "element.hover": "#33393d80",
        "element.selected": "#3b454b90",
        "ghost_element.hover": "#33393d70",
        "ghost_element.selected": "#3b454b90",
        "ghost_element.active": "#46545b90",
        "editor.highlighted_line.background": "#33393d45",
        "editor.active_line.background": "#33393d35",
        "editor.line_number": "#626a6e",
        "editor.active_line_number": "#d1b879",
        "editor.indent_guide": "#33393d",
        "editor.indent_guide_active": "#626a6e",
        "editor.wrap_guide": "#282d30",
        "editor.active_wrap_guide": "#46545b",
        "editor.document_highlight.read_background": "#86a9c730",
        "editor.document_highlight.write_background": "#d1b87930",
        "search.match_background": "#d1b87945",
        "panel.background": "#101315D9",
        "panel.indent_guide": "#33393d",
        "panel.indent_guide_active": "#626a6e",
        "pane.focused_border": "#46545b",
        "title_bar.background": "#101315D9",
        "title_bar.inactive_background": "#101315D9",
        "status_bar.background": "#101315D9",
        "drop_target.background": "#86a9c735",
        "elevated_surface.background": "#171b1d",
        "toolbar.background": "#101315D9",
        "tab_bar.background": "#101315D9",
        "tab.inactive_background": "#101315D9",
        "tab.active_background": "#33393d80",
        "scrollbar.track.background": "transparent",
        "scrollbar.track.border": "#101315",
        "scrollbar.thumb.background": "#626a6e80",
        "editor.gutter.background": "#101315D9",
        "error": "#d9847c",
        "warning": "#d1b879",
        "success": "#9fbd8a",
        "info": "#86a9c7",
        "hint": "#82b8b3",
        "created": "#9fbd8a",
        "modified": "#d1b879",
        "deleted": "#d9847c",
        "renamed": "#86a9c7",
        "conflict": "#d49a70",
        "terminal.background": "#101315D9",
        "terminal.foreground": "#d3d6d7",
        "terminal.dim_foreground": "#8b9397",
        "terminal.bright_foreground": "#eef0f0",
        "terminal.ansi.black": "#101315",
        "terminal.ansi.red": "#d9847c",
        "terminal.ansi.green": "#9fbd8a",
        "terminal.ansi.yellow": "#d1b879",
        "terminal.ansi.blue": "#86a9c7",
        "terminal.ansi.magenta": "#b39ac8",
        "terminal.ansi.cyan": "#82b8b3",
        "terminal.ansi.white": "#d3d6d7",
        "terminal.ansi.bright_black": "#707a80",
        "terminal.ansi.bright_red": "#e39a92",
        "terminal.ansi.bright_green": "#b3cf9f",
        "terminal.ansi.bright_yellow": "#dfca91",
        "terminal.ansi.bright_blue": "#9bbbd5",
        "terminal.ansi.bright_magenta": "#c5acd7",
        "terminal.ansi.bright_cyan": "#99cac5",
        "terminal.ansi.bright_white": "#eef0f0",
        "syntax": {
          "attribute": { "color": "#d49a70" },
          "boolean": { "color": "#d49a70" },
          "comment": { "color": "#707a80", "font_style": "italic" },
          "comment.doc": { "color": "#7f898e", "font_style": "italic" },
          "constant": { "color": "#c996aa" },
          "constructor": { "color": "#82b8b3" },
          "embedded": { "color": "#d3d6d7" },
          "emphasis": { "color": "#d1b879", "font_style": "italic" },
          "emphasis.strong": { "color": "#d1b879", "font_weight": 700 },
          "enum": { "color": "#82b8b3" },
          "function": { "color": "#86a9c7", "font_weight": 600 },
          "function.builtin": { "color": "#82b8b3" },
          "keyword": { "color": "#b39ac8", "font_style": "italic" },
          "label": { "color": "#d1b879" },
          "link_text": { "color": "#86a9c7" },
          "namespace": { "color": "#82b8b3" },
          "number": { "color": "#d49a70" },
          "operator": { "color": "#d1b879" },
          "property": { "color": "#c996aa" },
          "punctuation.bracket": { "color": "#b9bec0" },
          "punctuation.delimiter": { "color": "#8b9397" },
          "string": { "color": "#9fbd8a" },
          "string.escape": { "color": "#d1b879" },
          "string.regex": { "color": "#82b8b3" },
          "tag": { "color": "#d9847c" },
          "text.literal": { "color": "#9fbd8a" },
          "title": { "color": "#86a9c7", "font_weight": 700 },
          "type": { "color": "#82b8b3" },
          "variable": { "color": "#d3d6d7" },
          "variable.builtin": { "color": "#d9847c" },
          "variable.parameter": { "color": "#d3d6d7", "font_style": "italic" }
        },
        "players": [
          {
            "cursor": "#d1b879",
            "background": "#101315",
            "selection": "#86a9c740"
          }
        ]
      }
    }
  ]
}
