{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Rose Pine Dawn for Omarchy",
  "author": "nuggocto",
  "themes": [
    {
      "name": "Omarchy Light",
      "appearance": "light",
      "style": {
        "background": "#faf4edD9",
        "background.appearance": "blurred",
        "editor.background": "#faf4edD9",
        "editor.foreground": "#575279",
        "text": "#575279",
        "text.accent": "#286983",
        "text.muted": "#797593",
        "text.disabled": "#9893a5",
        "text.placeholder": "#9893a5",
        "icon": "#6e6a86",
        "icon.accent": "#286983",
        "icon.muted": "#9893a5",
        "ignored": "#9893a5",
        "hidden": "#9893a5",
        "predictive": "#9893a5",
        "border": "#cecacd",
        "border.focused": "#56949f",
        "border.selected": "#56949f",
        "border.variant": "#dfdad9",
        "element.hover": "#f2e9e1C0",
        "element.selected": "#dfdad9D9",
        "ghost_element.hover": "#f2e9e1B0",
        "ghost_element.selected": "#dfdad9D9",
        "ghost_element.active": "#cecacdD9",
        "editor.highlighted_line.background": "#f2e9e180",
        "editor.active_line.background": "#f2e9e160",
        "editor.line_number": "#9893a5",
        "editor.active_line_number": "#286983",
        "editor.indent_guide": "#dfdad9",
        "editor.indent_guide_active": "#cecacd",
        "editor.wrap_guide": "#e1dbd5",
        "editor.active_wrap_guide": "#cecacd",
        "editor.document_highlight.read_background": "#56949f30",
        "editor.document_highlight.write_background": "#ea9d3430",
        "search.match_background": "#ea9d3445",
        "panel.background": "#faf4edD9",
        "panel.indent_guide": "#dfdad9",
        "panel.indent_guide_active": "#cecacd",
        "pane.focused_border": "#56949f",
        "title_bar.background": "#faf4edD9",
        "title_bar.inactive_background": "#faf4edD9",
        "status_bar.background": "#faf4edD9",
        "drop_target.background": "#56949f35",
        "elevated_surface.background": "#fffaf3",
        "toolbar.background": "#faf4edD9",
        "tab_bar.background": "#faf4edD9",
        "tab.inactive_background": "#faf4edD9",
        "tab.active_background": "#f2e9e1D9",
        "scrollbar.track.background": "transparent",
        "scrollbar.track.border": "#faf4ed",
        "scrollbar.thumb.background": "#9893a580",
        "editor.gutter.background": "#faf4edD9",
        "error": "#b4637a",
        "warning": "#ea9d34",
        "success": "#6d8f89",
        "info": "#286983",
        "hint": "#56949f",
        "created": "#6d8f89",
        "modified": "#ea9d34",
        "deleted": "#b4637a",
        "renamed": "#286983",
        "conflict": "#cf8057",
        "terminal.background": "#faf4edD9",
        "terminal.foreground": "#575279",
        "terminal.dim_foreground": "#9893a5",
        "terminal.bright_foreground": "#575279",
        "terminal.ansi.black": "#f2e9e1",
        "terminal.ansi.red": "#b4637a",
        "terminal.ansi.green": "#286983",
        "terminal.ansi.yellow": "#ea9d34",
        "terminal.ansi.blue": "#56949f",
        "terminal.ansi.magenta": "#907aa9",
        "terminal.ansi.cyan": "#d7827e",
        "terminal.ansi.white": "#575279",
        "terminal.ansi.bright_black": "#9893a5",
        "terminal.ansi.bright_red": "#b4637a",
        "terminal.ansi.bright_green": "#286983",
        "terminal.ansi.bright_yellow": "#ea9d34",
        "terminal.ansi.bright_blue": "#56949f",
        "terminal.ansi.bright_magenta": "#907aa9",
        "terminal.ansi.bright_cyan": "#d7827e",
        "terminal.ansi.bright_white": "#575279",
        "syntax": {
          "attribute": { "color": "#907aa9" },
          "boolean": { "color": "#ea9d34" },
          "comment": { "color": "#6e6a86", "font_style": "italic" },
          "comment.doc": { "color": "#797593", "font_style": "italic" },
          "constant": { "color": "#ea9d34" },
          "constructor": { "color": "#d7827e" },
          "embedded": { "color": "#575279" },
          "emphasis": { "color": "#907aa9", "font_style": "italic" },
          "emphasis.strong": { "color": "#b4637a", "font_weight": 700 },
          "enum": { "color": "#6d8f89" },
          "function": { "color": "#286983", "font_weight": 600 },
          "function.builtin": { "color": "#56949f" },
          "keyword": { "color": "#b4637a", "font_style": "italic" },
          "label": { "color": "#907aa9" },
          "link_text": { "color": "#286983" },
          "namespace": { "color": "#56949f" },
          "number": { "color": "#907aa9" },
          "operator": { "color": "#b4637a" },
          "property": { "color": "#907aa9" },
          "punctuation.bracket": { "color": "#6e6a86" },
          "punctuation.delimiter": { "color": "#797593" },
          "string": { "color": "#6d8f89" },
          "string.escape": { "color": "#d7827e" },
          "string.regex": { "color": "#286983" },
          "tag": { "color": "#b4637a" },
          "text.literal": { "color": "#6d8f89" },
          "title": { "color": "#286983", "font_weight": 700 },
          "type": { "color": "#6d8f89" },
          "variable": { "color": "#575279" },
          "variable.builtin": { "color": "#56949f" },
          "variable.parameter": { "color": "#575279", "font_style": "italic" }
        },
        "players": [
          {
            "cursor": "#286983",
            "background": "#faf4ed",
            "selection": "#56949f40"
          }
        ]
      }
    }
  ]
}
