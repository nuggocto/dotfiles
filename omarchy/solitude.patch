diff --git a/obsidian.css b/obsidian.css
new file mode 100644
index 0000000..0274b8a
--- /dev/null
+++ b/obsidian.css
@@ -0,0 +1,95 @@
+/* Solitude for Obsidian */
+
+.theme-dark,
+.theme-light {
+  --background-primary: #101315;
+  --background-primary-alt: #171b1d;
+  --background-secondary: #171b1d;
+  --background-secondary-alt: #282d30;
+  --background-modifier-border: #33393d;
+  --background-modifier-hover: #282d30;
+  --background-modifier-active-hover: #33393d;
+  --text-normal: #d3d6d7;
+  --text-muted: #8b9397;
+  --text-faint: #707a80;
+  --text-selection: #46545b;
+  --text-on-accent: #101315;
+  --text-error: #d9847c;
+  --text-error-hover: #e39a92;
+  --text-success: #9fbd8a;
+  --text-warning: #d1b879;
+  --text-accent: #86a9c7;
+  --text-accent-hover: #9bbbd5;
+  --text-link: #86a9c7;
+  --text-link-decoration: #46545b;
+  --interactive-accent: #86a9c7;
+  --interactive-accent-hover: #9bbbd5;
+  --interactive-normal: #282d30;
+  --interactive-hover: #33393d;
+  --code-background: #171b1d;
+  --code-normal: #d3d6d7;
+  --text-title-h1: #86a9c7;
+  --text-title-h2: #82b8b3;
+  --text-title-h3: #9fbd8a;
+  --text-title-h4: #d1b879;
+  --text-title-h5: #d49a70;
+  --text-title-h6: #b39ac8;
+  --tag-color: #82b8b3;
+  --tag-background: #282d30;
+  --tag-background-hover: #33393d;
+  --graph-line: #46545b;
+  --graph-node: #86a9c7;
+  --graph-node-focused: #d1b879;
+  --graph-node-tag: #82b8b3;
+  --graph-node-attachment: #b39ac8;
+}
+
+.cm-header-1,
+.markdown-rendered h1 { color: var(--text-title-h1); }
+.cm-header-2,
+.markdown-rendered h2 { color: var(--text-title-h2); }
+.cm-header-3,
+.markdown-rendered h3 { color: var(--text-title-h3); }
+.cm-header-4,
+.markdown-rendered h4 { color: var(--text-title-h4); }
+.cm-header-5,
+.markdown-rendered h5 { color: var(--text-title-h5); }
+.cm-header-6,
+.markdown-rendered h6 { color: var(--text-title-h6); }
+
+.cm-s-obsidian span.cm-keyword,
+.HyperMD-codeblock .cm-keyword { color: #b39ac8; }
+.cm-s-obsidian span.cm-string,
+.HyperMD-codeblock .cm-string { color: #9fbd8a; }
+.cm-s-obsidian span.cm-number,
+.cm-s-obsidian span.cm-atom,
+.HyperMD-codeblock .cm-number,
+.HyperMD-codeblock .cm-atom { color: #d49a70; }
+.cm-s-obsidian span.cm-comment,
+.HyperMD-codeblock .cm-comment { color: #707a80; font-style: italic; }
+.cm-s-obsidian span.cm-operator,
+.HyperMD-codeblock .cm-operator { color: #d1b879; }
+.cm-s-obsidian span.cm-def,
+.cm-s-obsidian span.cm-variable-2,
+.HyperMD-codeblock .cm-def { color: #86a9c7; }
+.cm-s-obsidian span.cm-variable-3,
+.cm-s-obsidian span.cm-type,
+.HyperMD-codeblock .cm-type { color: #82b8b3; }
+.cm-s-obsidian span.cm-property,
+.cm-s-obsidian span.cm-attribute,
+.HyperMD-codeblock .cm-property { color: #c996aa; }
+.cm-s-obsidian span.cm-tag,
+.HyperMD-codeblock .cm-tag { color: #d9847c; }
+.cm-s-obsidian span.cm-builtin,
+.HyperMD-codeblock .cm-builtin { color: #82b8b3; }
+
+.markdown-rendered blockquote {
+  border-left-color: #86a9c7;
+  color: #b9bec0;
+}
+
+.workspace-leaf.mod-active .workspace-leaf-header-title,
+.nav-file-title.is-active,
+.search-result-file-title {
+  color: var(--text-accent);
+}
diff --git a/typora.css b/typora.css
new file mode 100644
index 0000000..b43fb7e
--- /dev/null
+++ b/typora.css
@@ -0,0 +1,94 @@
+@import "night/mermaid.dark.css";
+@import "night/codeblock.dark.css";
+@import "night/sourcemode.dark.css";
+
+:root {
+  --bg-color: #101315;
+  --side-bar-bg-color: #171b1d;
+  --text-color: #d3d6d7;
+  --select-text-bg-color: #46545b;
+  --item-hover-bg-color: #282d30;
+  --control-text-color: #707a80;
+  --control-text-hover-color: #d3d6d7;
+  --window-border: 1px solid #282d30;
+  --active-file-bg-color: #282d30;
+  --active-file-border-color: #86a9c7;
+  --active-file-text-color: #d3d6d7;
+  --item-hover-text-color: #d3d6d7;
+  --primary-color: #86a9c7;
+  --rawblock-edit-panel-bd: #171b1d;
+  --search-select-bg-color: #46545b;
+}
+
+html {
+  font-size: 16px;
+  -webkit-font-smoothing: antialiased;
+}
+
+html,
+body {
+  background: var(--bg-color);
+  color: var(--text-color);
+  fill: currentColor;
+  line-height: 1.625rem;
+}
+
+#write { max-width: 914px; }
+@media only screen and (min-width: 1400px) { #write { max-width: 1024px; } }
+@media only screen and (min-width: 1800px) { #write { max-width: 1200px; } }
+
+html,
+body,
+button,
+input,
+select,
+textarea {
+  font-family: "Inter", "SF Pro", -apple-system, BlinkMacSystemFont, sans-serif;
+}
+
